{
  "name": "veilq-ui",
  "private": true,
  "version": "0.2.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "description": "Web UI for veilq: the input beside the redacted output, served by `veilq ui`",
  "scripts": {
    "dev": "vite --mode mock",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:mock": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
