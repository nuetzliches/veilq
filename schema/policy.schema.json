{
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "const": "mask",
          "description": "`<PERSON>`.",
          "type": "string"
        },
        {
          "const": "pseudonymize",
          "description": "`[PERSON:ab12cd34]` (ADR-0001); needs a key.",
          "type": "string"
        },
        {
          "const": "fake",
          "description": "A plausible value of the same type and shape.",
          "type": "string"
        },
        {
          "const": "remove",
          "description": "Nothing: the span is dropped.",
          "type": "string"
        }
      ]
    },
    "Allow": {
      "additionalProperties": false,
      "description": "What is never personal data here: the firm's own name, court names.",
      "properties": {
        "patterns": {
          "default": [],
          "description": "Rust `regex` patterns a whole finding must match.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "values": {
          "default": [],
          "description": "Exact values, compared after the same normalisation as pseudonyms.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Context": {
      "additionalProperties": false,
      "description": "Words near a match that make it personal data: `geb.` before a date, the\ncolumn `email`, the key `iban` (ADR-0011).",
      "properties": {
        "boost": {
          "default": 0.30000001192092896,
          "description": "Added to the confidence when a word is found; from 0 to 1.",
          "format": "float",
          "type": "number"
        },
        "window": {
          "default": 48,
          "description": "How many characters before the match are searched, the column's or\nkey's name included.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "words": {
          "description": "Compared case-insensitively; a word that starts with a letter or digit\nmust start a word in the text too.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "words"
      ],
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/Action",
          "default": "mask"
        },
        "min_confidence": {
          "default": 0.699999988079071,
          "description": "Findings below this confidence are dropped; from 0 to 1.",
          "format": "float",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Detectors": {
      "additionalProperties": false,
      "properties": {
        "require": {
          "default": [],
          "description": "Detectors without which a run fails (`ner`, `ocr`, ...); `pattern`\nalways runs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Embedded": {
      "enum": [
        "error",
        "remove"
      ],
      "type": "string"
    },
    "EntityRule": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/Action"
            },
            {
              "type": "null"
            }
          ]
        },
        "min_confidence": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "EntityType": {
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "type": "string"
    },
    "Mapping": {
      "additionalProperties": false,
      "description": "The mapping file: what `pseudonymize` and `fake` replacements stood for.",
      "properties": {
        "recipients": {
          "description": "age X25519 recipients (`age1...`) the mapping is encrypted to. Only\npublic keys: whoever holds a matching identity can read it.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "recipients"
      ],
      "type": "object"
    },
    "Office": {
      "additionalProperties": false,
      "description": "How Office files are read.",
      "properties": {
        "embedded": {
          "$ref": "#/$defs/Embedded",
          "default": "error",
          "description": "Images and embedded objects, which veilq does not read until M4:\n`error` (the default) stops the run, `remove` blanks images (the\nreport then asks for a review); other objects stay an error."
        }
      },
      "type": "object"
    },
    "PatternRule": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": 0.8999999761581421,
          "format": "float",
          "type": "number"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/Context"
            },
            {
              "type": "null"
            }
          ]
        },
        "entity": {
          "$ref": "#/$defs/EntityType"
        },
        "name": {
          "description": "Lower case letters, digits and `-`; the detector is `policy:<name>`\n(built-in: `pattern:<locale>.<name>`).",
          "type": "string"
        },
        "regex": {
          "description": "A Rust `regex` pattern. With a group named `pii`, only that group is\nthe finding (the rest is context the match needs).",
          "type": "string"
        },
        "validate": {
          "description": "A check the match must pass (`iban`, `luhn`, `tax_id_de`, ...). A\nmatch that fails it loses 0.3 of its confidence: below the threshold\nwithout context, above it with (ADR-0012).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "entity",
        "regex"
      ],
      "type": "object"
    },
    "Pseudonymize": {
      "additionalProperties": false,
      "properties": {
        "key_env": {
          "description": "The environment variable that holds the key (at least 16 bytes). The\nkey itself never goes into the policy.",
          "type": "string"
        }
      },
      "required": [
        "key_env"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow": {
      "$ref": "#/$defs/Allow",
      "default": {
        "patterns": [],
        "values": []
      }
    },
    "defaults": {
      "$ref": "#/$defs/Defaults",
      "default": {
        "action": "mask",
        "min_confidence": 0.699999988079071
      }
    },
    "detectors": {
      "$ref": "#/$defs/Detectors",
      "default": {
        "require": []
      }
    },
    "entities": {
      "additionalProperties": false,
      "default": {},
      "description": "Per entity type: what differs from `defaults`.",
      "patternProperties": {
        "^[A-Z][A-Z0-9_]*$": {
          "$ref": "#/$defs/EntityRule"
        }
      },
      "type": "object"
    },
    "locales": {
      "default": [
        "de",
        "en"
      ],
      "description": "The locales whose built-in patterns run (ADR-0010); the\nlocale-independent ones (e-mail, IBAN, IP, cards) always run.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "mapping": {
      "anyOf": [
        {
          "$ref": "#/$defs/Mapping"
        },
        {
          "type": "null"
        }
      ],
      "description": "Who can read a mapping file (ADR-0018)."
    },
    "office": {
      "$ref": "#/$defs/Office",
      "default": {
        "embedded": "error"
      },
      "description": "Office files (ADR-0019)."
    },
    "patterns": {
      "default": [],
      "description": "The project's own patterns.",
      "items": {
        "$ref": "#/$defs/PatternRule"
      },
      "type": "array"
    },
    "pseudonymize": {
      "anyOf": [
        {
          "$ref": "#/$defs/Pseudonymize"
        },
        {
          "type": "null"
        }
      ],
      "description": "Required when any action is `pseudonymize`."
    },
    "version": {
      "description": "The format's version; `1`.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version"
  ],
  "title": "Policy",
  "type": "object"
}
