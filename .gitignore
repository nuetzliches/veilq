/target/
.env
.env.*
!.env.example

# Downloaded models (NER, OCR): pinned by checksum, never committed.
/models/

# Local notes and scratch input: they may hold real content.
*.local.md
/scratch/

# Agent session state.
/.claude/*
!/.claude/skills/

# The web UI (ui/): dependencies and build, embedded by `veilq ui`.
/ui/node_modules
/ui/dist/

# devstack: lane snapshots, build artifacts, daemon state (devstack.toml).
.devstack/
